# Copy to .env and fill in real values. Never commit .env.
# Local values come from `npx supabase status` after `npx supabase start`.

# --- Database (Supabase Postgres) ---
# Local Supabase CLI stack:
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Hosted Supabase: use the *session pooler* string (port 5432, works over IPv4), e.g.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key (sb_secret_… or legacy service_role). Used to create/update users. Never expose it.
SUPABASE_SECRET_KEY=
# Only needed for HS256-signed tokens (legacy JWT secret; the local CLI prints it as "JWT secret").
# Projects on asymmetric signing keys are verified through JWKS and can leave this empty.
SUPABASE_JWT_SECRET=
# Optional: the issuer (`iss`) in tokens, if it isn't <SUPABASE_URL>/auth/v1 (docker-compose sets it).
# SUPABASE_JWT_ISSUER=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Business defaults ---
DEFAULT_TAX_RATE=0
DEFAULT_CURRENCY=SAR
# IANA time zone that defines the business day for date filters (e.g. "today's" movements).
BUSINESS_TIMEZONE=Asia/Riyadh

# --- AI assistant: Google Gemini (server-side only) ---
# API key from Google AI Studio (https://aistudio.google.com/apikey). Backend only: never put it in a
# VITE_ variable. Left empty, the app runs normally and the AI endpoints answer 503 AI_UNAVAILABLE.
LLM_API_KEY=
# Gemini model ID. Empty = gemini-3.5-flash-lite (stable, fast, lowest cost, has a free tier).
# For stronger answers try gemini-3.8-flash. Current IDs: https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=
# Seconds to wait for one model response (optional, default 30).
# LLM_TIMEOUT_SECONDS=30
# AI requests per user per rolling hour (AI-8).
AI_RATE_LIMIT_PER_HOUR=20

# --- Seed admin (backend/scripts/seed.py) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# --- Frontend (public values only) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_… or legacy anon key). Safe for the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
